title               =  GO_Na
define              =  
integrator          =  md
dt                  =  0.001    ; ps !
nsteps              =  50000000
comm_mode           =  Linear
comm_grps           =  nofrozen
nstxout             =  500
nstvout             =  0
nstlog              =  1000
nstenergy           =  1000
;nstxtcout           =  10000
nstlist             =  10
ns_type             =  grid
pbc                 =  xyz
periodic_molecules  =  yes
rlist               =  1.0
coulombtype         =  PME
rcoulomb            =  1.0
vdwtype             =  cut-off
rvdw                =  1.0
DispCorr            =  EnerPres
fourierspacing		=  0.12
fourier_nx		=  0
fourier_ny		=  0
fourier_nz		=  0
pme_order		=  4
ewald_rtol		=  1e-5
optimize_fft		=  yes
tcoupl                  =  nose-hoover
ref_t                   =  300
tau_t                   =  0.5
tc_grps                 =  System
;pcoupl                  =  berendsen
;pcoupltype              =  semiisotropic
;tau_p                   =  1.0 1.0
;compressibility         =  0.0 4.5e-5
;ref_p                   =  1.0 1.0
gen_vel                 =  no
gen_temp                =  300
gen_seed                =  175298
freezegrps              =  GO_frozen
freezedim               =  Y Y Y
constraints             =  h-bonds
constraint_algorithm    =  LINCS
shake_tol               =  0.0001
lincs_order             =  4
lincs_iter              =  1
lincs_warnangle         =  30
